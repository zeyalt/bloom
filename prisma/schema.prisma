generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Child {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(255)
  nickname        String?   @db.VarChar(255)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  school          String?   @db.VarChar(255)
  colorCode       String    @map("color_code") @db.VarChar(7)
  avatarEmoji     String    @map("avatar_emoji") @db.Char(2)
  avatarKey       String?   @map("avatar_key") @db.VarChar(50)
  // School level as a code (K1, P2, S1…), the year it was true for, and whether it moves
  // up each January — so P2 in 2026 reads as P3 in 2027 without editing.
  schoolLevel     String?   @map("school_level") @db.VarChar(20)
  schoolLevelYear Int?      @map("school_level_year")
  autoPromote     Boolean   @default(true) @map("auto_promote")
  calendarId      String?   @map("calendar_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp()

  activities     Activity[]
  attendanceLogs AttendanceLog[]
  expenses       Expense[]
  milestones     Milestone[]
  goals          Goal[]
  calendar       SchoolCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  schoolHours    SchoolHours[]
  routineItems   RoutineItem[]
  dayPlans       DayPlan[]
  oneOffTasks    OneOffTask[]
  taskTicks      TaskTick[]

  @@map("children")
}

model ActivityCategory {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  colorCode String   @map("color_code") @db.VarChar(7)
  icon      String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  activities Activity[]
  expenses   Expense[]

  @@map("activity_categories")
}

// Cached AI summaries, keyed by scope: "all" | "child:<id>" | "activity:<id>"
model AiSummary {
  scope       String   @id
  summary     String   @db.Text
  generatedAt DateTime @map("generated_at") @db.Timestamp()

  @@map("ai_summaries")
}

model Activity {
  id             String    @id @default(cuid())
  childId        String    @map("child_id")
  categoryId     String    @map("category_id")
  activityName   String?   @map("activity_name") @db.VarChar(255)
  institution    String    @db.VarChar(255)
  instructorName String?   @map("instructor_name") @db.VarChar(255)
  level          String?   @db.VarChar(50)
  status         String    @default("active") @db.VarChar(50)
  // A must-do that My Day adds on this class's days, e.g. "Pack swimming kit".
  prepTask       String?   @map("prep_task") @db.VarChar(255)
  // Homework after every lesson, counted from this date (null = this class gives none),
  // with an optional note, e.g. "Worksheet and spelling".
  homeworkFrom   DateTime? @map("homework_from") @db.Date
  homeworkNote   String?   @map("homework_note") @db.VarChar(255)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp()

  child          Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  category       ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  schedules      Schedule[]
  attendanceLogs AttendanceLog[]
  expenses       Expense[]
  milestones     Milestone[]

  @@map("activities")
}

model Schedule {
  id              String    @id @default(cuid())
  activityId      String    @map("activity_id")
  dayOfWeek       Int       @map("day_of_week")
  startTime       String    @map("start_time") @db.VarChar(5)
  endTime         String?   @map("end_time") @db.VarChar(5)
  durationMinutes Int?      @map("duration_minutes")
  location        String?   @db.VarChar(255)
  term            String?   @db.VarChar(100)
  isActive        Boolean   @default(true) @map("is_active")
  effectiveFrom   DateTime? @map("effective_from") @db.Date
  effectiveUntil  DateTime? @map("effective_until") @db.Date
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp()

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model AttendanceLog {
  id              String   @id @default(cuid())
  activityId      String   @map("activity_id")
  childId         String   @map("child_id")
  date            DateTime @db.Date
  startTime       String?  @map("start_time") @db.VarChar(5)
  endTime         String?  @map("end_time") @db.VarChar(5)
  durationMinutes Int?     @map("duration_minutes")
  status          String   @db.VarChar(50)
  sentBy          String?  @map("sent_by") @db.VarChar(255)
  fetcher         String?  @db.VarChar(255)
  instructorName  String?  @map("instructor_name") @db.VarChar(255)
  lessonType      String?  @map("lesson_type") @db.VarChar(50)
  location        String?  @db.VarChar(255)
  absenceReason   String?  @map("absence_reason") @db.VarChar(255)
  lessonNumber    Int?     @map("lesson_number")
  level           String?  @db.VarChar(50)
  learned         String?  @db.Text
  diaryNotes      String?  @map("diary_notes") @db.Text
  remarks         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp()

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("attendance_logs")
}

model Expense {
  id           String   @id @default(cuid())
  childId      String   @map("child_id")
  categoryId   String   @map("category_id")
  activityId   String?  @map("activity_id")
  institution  String   @db.VarChar(255)
  description  String   @db.VarChar(500)
  amount       Float
  paymentDate  DateTime @map("payment_date") @db.Date
  paidBy       String   @map("paid_by") @db.VarChar(100)
  year         Int
  numLessons   Int?     @map("num_lessons")
  expenseType  String   @default("Lesson") @map("expense_type") @db.VarChar(50)
  receiptNotes String?  @map("receipt_notes") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp()

  child    Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  category ActivityCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  activity Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model Milestone {
  id            String   @id @default(cuid())
  activityId    String   @map("activity_id")
  childId       String   @map("child_id")
  date          DateTime @db.Date
  milestoneType String   @map("milestone_type") @db.VarChar(50)
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  result        String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp()

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

model Sender {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(255)
  relationship String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()

  @@map("senders")
}

// Per-child goals. kind = "milestone" (something to learn or do, with an optional
// action plan of dated checkpoints) or "measured" (a number to reach, e.g. height).
model Goal {
  id           String    @id @default(cuid())
  childId      String    @map("child_id")
  kind         String    @db.VarChar(20)
  title        String    @db.VarChar(255)
  targetDate   DateTime  @map("target_date") @db.Date
  achievedDate DateTime? @map("achieved_date") @db.Date
  unit         String?   @db.VarChar(20)
  targetValue  Float?    @map("target_value")
  // Practice My Day adds while the goal is open, e.g. "Cube practice · 15 min",
  // on "school" days, "holiday" days or "any" day.
  practiceTask String?   @map("practice_task") @db.VarChar(255)
  practiceDays String?   @map("practice_days") @db.VarChar(10)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp()

  child       Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  checkpoints GoalCheckpoint[]
  entries     GoalEntry[]

  @@index([childId])
  @@map("goals")
}

// One step of a milestone goal's action plan.
model GoalCheckpoint {
  id        String    @id @default(cuid())
  goalId    String    @map("goal_id")
  dueDate   DateTime  @map("due_date") @db.Date
  text      String    @db.VarChar(500)
  hitDate   DateTime? @map("hit_date") @db.Date
  sortOrder Int       @default(0) @map("sort_order")

  goal   Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  focus  GoalFocus[]

  @@index([goalId])
  @@map("goal_checkpoints")
}

// A focus point under a checkpoint: the "how" of hitting it ("plan during inspection").
// A habit being worked on, not a daily task: gotDate is set once a parent sees it stick.
model GoalFocus {
  id           String    @id @default(cuid())
  checkpointId String    @map("checkpoint_id")
  text         String    @db.VarChar(300)
  gotDate      DateTime? @map("got_date") @db.Date
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  checkpoint GoalCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([checkpointId])
  @@map("goal_focus")
}

// A dated update (note, milestone goals) or reading (value, measured goals).
model GoalEntry {
  id        String   @id @default(cuid())
  goalId    String   @map("goal_id")
  date      DateTime @db.Date
  note      String?  @db.Text
  value     Float?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_entries")
}

// ─── My Day ──────────────────────────────────────────────────────────────────

// A child's school hours for one weekday (0 = Sunday … 6 = Saturday).
model SchoolHours {
  id               String  @id @default(cuid())
  childId          String  @map("child_id")
  dayOfWeek        Int     @map("day_of_week")
  isSchoolDay      Boolean @default(false) @map("is_school_day")
  startTime        String? @map("start_time") @db.VarChar(5)
  endTime          String? @map("end_time") @db.VarChar(5)
  // An after-school activity on this weekday (e.g. "CCA – Badminton") and when it ends:
  // My Day shows it on the timetable and counts "home from school" from that time.
  afterSchool      String? @map("after_school") @db.VarChar(255)
  afterSchoolUntil String? @map("after_school_until") @db.VarChar(5)

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, dayOfWeek])
  @@map("school_hours")
}

// A set of term dates and school holidays that children follow.
// kind = "moe_primary" (imported from MOE) or "custom" (typed in).
model SchoolCalendar {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  kind      String   @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()

  children Child[]
  days     CalendarDay[]

  @@map("school_calendars")
}

// A dated span on a calendar. calendarId = null means it applies to everyone
// (public holidays). kind: term | school_holiday | public_holiday | half_day | no_school.
// levels: comma-separated level codes it applies to ("P2,P3"); null = every level.
// source: moe | data.gov.sg | you. Imported rows have stable ids so re-importing updates them.
model CalendarDay {
  id         String   @id @default(cuid())
  calendarId String?  @map("calendar_id")
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  kind       String   @db.VarChar(30)
  title      String   @db.VarChar(255)
  endsAt     String?  @map("ends_at") @db.VarChar(5)
  levels     String?  @db.VarChar(100)
  source     String   @default("you") @db.VarChar(30)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp()

  calendar SchoolCalendar? @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([startDate])
  @@map("calendar_days")
}

// One line of a child's routine, on the weekdays picked (0–6; empty = every day) from
// startDate to endDate (no end date = goes on). tier: anchor (a fixed time on the timetable,
// e.g. Dinner 18:30 — not ticked) | must | practice | free.
// (The table still has an unused day_type column, defaulting to 'any'; drop it later.)
model RoutineItem {
  id        String    @id @default(cuid())
  childId   String    @map("child_id")
  weekdays  Int[]     @default([])
  startDate DateTime  @default(dbgenerated("CURRENT_DATE")) @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  tier      String   @db.VarChar(10)
  title     String   @db.VarChar(255)
  atTime    String?  @map("at_time") @db.VarChar(5)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp()

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("routine_items")
}

// A task a child ticked on My Day, with the moment they ticked it. itemKey names what was
// ticked: routine:<id> | prep:<activityId> | goal:<goalId> | homework:<activityId>:<lessonDate>
// (homework ticks are dated by the lesson, so they stay done across days). title and tier are copied at
// tick time so the log still reads right after the routine is edited.
model TaskTick {
  id      String   @id @default(cuid())
  childId String   @map("child_id")
  date    DateTime @db.Date
  itemKey String   @map("item_key") @db.VarChar(100)
  title   String   @db.VarChar(255)
  tier    String   @db.VarChar(10)
  doneAt  DateTime @map("done_at") @db.Timestamptz()
  // A parent marked this (homework) as not needed — "No homework this time".
  skipped Boolean  @default(false)
  // Who ticked it: "child" (the tablet) or "parent" (Home).
  by      String   @default("child") @db.VarChar(10)

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date, itemKey])
  @@index([date])
  @@map("task_ticks")
}

// The list a child had to do on a day, saved as it's shown, so a past day shows the routine
// as it was then rather than as it is now. items: [{ key, title, tier, source }].
model DayPlan {
  id      String   @id @default(cuid())
  childId String   @map("child_id")
  date    DateTime @db.Date
  items   Json
  savedAt DateTime @default(now()) @updatedAt @map("saved_at") @db.Timestamptz()

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date])
  @@map("day_plans")
}

/// A task for one child on one date only ("Pack swimming bag"), added from Home.
model OneOffTask {
  id        String   @id @default(cuid())
  childId   String   @map("child_id")
  date      DateTime @db.Date
  title     String   @db.VarChar(255)
  tier      String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("one_off_tasks")
}
